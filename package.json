{
  "name": "ai-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first desktop workspace for multi-provider AI research, answer optimization, and supervised GEO studies.",
  "author": "blockframe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blockframe/AI-workspace.git"
  },
  "homepage": "https://github.com/blockframe/AI-workspace#readme",
  "bugs": {
    "url": "https://github.com/blockframe/AI-workspace/issues"
  },
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.3",
  "keywords": [
    "electron",
    "react",
    "typescript",
    "ai",
    "desktop",
    "research",
    "geo",
    "local-first",
    "chatgpt",
    "claude",
    "gemini",
    "perplexity"
  ],
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "wait-on tcp:5173 dist-electron/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "start": "electron .",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "package:all": "npm run build && electron-builder -mwl"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "^1.94.0",
    "electron-updater": "^6.8.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.aiworkspace.desktop",
    "productName": "AI Workspace",
    "artifactName": "AI-Workspace-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BlockFrame",
        "repo": "AI-workspace",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "minimumSystemVersion": "10.15.0"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility;Network;",
      "maintainer": "blockframe <blockframe@users.noreply.github.com>",
      "synopsis": "AI Workspace Desktop App",
      "description": "A secure desktop workspace for managing, comparing, and broadcasting prompts across multiple AI services."
    },
    "deb": {
      "priority": "optional"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
