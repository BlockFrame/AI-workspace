{
  "name": "ai-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "A secure desktop workspace for managing, comparing, and broadcasting prompts across multiple AI services.",
  "author": "blockframe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blockframe/AI-workspace.git"
  },
  "homepage": "https://github.com/blockframe/AI-workspace#readme",
  "bugs": {
    "url": "https://github.com/blockframe/AI-workspace/issues"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "ai",
    "desktop",
    "chatgpt",
    "claude",
    "gemini",
    "perplexity"
  ],
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "wait-on tcp:5173 dist-electron/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "start": "electron .",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "^1.94.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.aiworkspace.desktop",
    "productName": "AI Workspace",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
